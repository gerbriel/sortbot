# Fly.io deployment for the matting service.
#
#   cp fly.toml.example fly.toml   &&   edit `app`
#   fly launch --no-deploy --copy-config
#   fly secrets set SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... \
#                   SUPABASE_ANON_KEY=... REPLICATE_API_TOKEN=...
#   fly deploy
#   fly certs add matting.arcadian.ltd
#
# Fly is not special here — this is one stateless container with four secrets
# and a health check, so any Docker host will do (see README "Deploying").

app = "arcadian-matting"           # <- change me
primary_region = "iad"             # put it near the Supabase project

[build]
  dockerfile = "Dockerfile"

[env]
  MATTING_BACKEND = "replicate"
  REPLICATE_MODEL = "men1scus/birefnet"
  # PIN THE MODEL. The service refuses to start without this outside
  # MATTING_ENV=dev — an unpinned model changes weights without notice and
  # makes a catalog's cutouts inconsistent, which is worse than having none.
  # The startup log prints the current latest so re-pinning is a copy-paste.
  REPLICATE_VERSION = "f74986db0355b58403ed20963af156525e2891ea3c2d499bfbfb2a28cd87c5d7"
  ALLOWED_ORIGINS = "https://arcadian.ltd,http://localhost:5173"
  BUCKET = "product-images"
  # Four images in flight. Each one is mostly waiting on Replicate, so this is
  # a concurrency limit against the upstream rate limit, not a CPU count.
  CONCURRENCY = "4"
  MAX_IDS_PER_JOB = "2000"

[http_service]
  internal_port = 8080
  force_https = true

  # SCALE TO ZERO. The founder mats a batch and then does not touch this for
  # days; paying for an idle machine the rest of the week is most of the cost of
  # running it. A cold start is ~2 s of Python import, against ~2-30 s of
  # Replicate container boot on the first image — so the user never sees it.
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [http_service.concurrency]
    type = "requests"
    # Well above CONCURRENCY: these are cheap poll requests from the browser
    # progress bar, not units of matting work.
    soft_limit = 40
    hard_limit = 80

[[http_service.checks]]
  grace_period = "20s"
  interval = "30s"
  method = "GET"
  path = "/healthz"
  timeout = "5s"

[[vm]]
  size = "shared-cpu-1x"
  # 1 GB is generous for the replicate backend: the peak is decoding one 12 MP
  # JPEG plus a float32 alpha (~50 MB per in-flight image) times CONCURRENCY.
  #
  # THE `local` BACKEND DOES NOT FIT HERE. BiRefNet at 1024 needs >= 8 GB and at
  # 2048 >= 16 GB on CPU, and a CPU pass is ~15 s an image against ~2 s hosted.
  # If you switch MATTING_BACKEND=local, resize first — it will not OOM
  # gracefully, it will be killed mid-batch and leave rows 'queued'.
  memory = "1gb"

# A SIGTERM mid-image leaves a row 'queued' with an orphaned cutout already
# uploaded. The app drains in-flight work on shutdown (app/jobs.py), so give it
# room to finish rather than the default 5 s.
[deploy]
  strategy = "immediate"

[experimental]
  kill_signal = "SIGTERM"
  kill_timeout = 40
