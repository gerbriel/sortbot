# Copy this file to .env and fill in the values.
#
# ⚠️  SECURITY: every variable here is prefixed VITE_, which means Vite compiles it
# into the PUBLIC JavaScript bundle. Anyone who visits the deployed site can read it.
# Only ever put publishable values in this file.
#
# NEVER put a Supabase service_role key, a Shopify Admin token, or any other real
# secret in a VITE_ variable — it would be published to every visitor and would
# bypass RLS. Server-side secrets belong in Supabase Edge Function secrets instead
# (`supabase secrets set ...`). See the Security section of README.md.

# ---- Required -------------------------------------------------------------
# The app throws on load without these two.

# Your Supabase project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co

# The Supabase ANON (publishable) key — NOT the service_role key.
# This one is public by design; RLS is what enforces access.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Optional -------------------------------------------------------------

# Denominator for the storage usage meter, in GB. 1 = free tier, 100 = Pro.
VITE_STORAGE_LIMIT_GB=100

# The self-hosted photo-background (matting) service — see services/matting/.
# LEAVE IT EMPTY and the whole feature is off: no Backgrounds control in Step 2,
# no export gate, no settings section. It is an ORIGIN, not a secret: the app
# calls it with the signed-in user's own Supabase session JWT, so there is
# nothing here that a visitor could not already read.
#
# Local development: http://localhost:8080 (vite.config.ts widens the dev CSP
# for exactly that origin; the production policy in index.html names
# https://matting.arcadian.ltd and nothing else).
VITE_MATTING_URL=

# ---- Analytics, CRM, messaging, error tracking -----------------------------
# All four are FIRST-PARTY features stored in this project's own Supabase
# tables (see supabase/migrations/analytics_events.sql, crm.sql,
# support_messaging.sql, app_errors.sql). There is no third-party service and
# nothing to configure here — run the migrations and they are on.
#
# The two Edge Functions read their own secrets server-side, never from here:
#   shopify-titles  -> SHOPIFY_STORE, SHOPIFY_ADMIN_TOKEN
#   generate-prose  -> CF_ACCOUNT_ID, CF_API_TOKEN
# Set them with `supabase secrets set ...`.
#
# The uptime workflow (.github/workflows/uptime.yml) needs the two required
# values above as GitHub repository secrets, under the same names.
